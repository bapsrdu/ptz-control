{
  "name": "universal-ptz-controller",
  "productName": "Universal PTZ Controller",
  "version": "0.10.0",
  "description": "Universal PTZ Controller: simple PTZ camera control for temple AV volunteers",
  "main": "main.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:renderer": "vite build",
    "prestart": "npm run build:renderer",
    "start": "electron .",
    "dev:renderer": "vite",
    "sim": "node sim/fake-camera.js",
    "test": "node --test --test-timeout=20000 tests/*.test.js",
    "test:e2e": "npm run build:renderer && node --test --test-timeout=60000 e2e/*.test.js",
    "lint": "eslint .",
    "dist:win": "npm run build:renderer && electron-builder --win --publish never",
    "dist:mac": "npm run build:renderer && electron-builder --mac --publish never",
    "dist:linux": "npm run build:renderer && electron-builder --linux dir --publish never"
  },
  "dependencies": {
    "atem-connection": "^3.10.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mediapipe/pose": "^0.5.1675469404",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lucide-react": "^1.72.0",
    "playwright-core": "^1.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron": true
  },
  "author": "Universal PTZ Controller contributors",
  "build": {
    "appId": "app.ptzcontrol",
    "productName": "Universal PTZ Controller",
    "copyright": "Universal PTZ Controller contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "package.json",
      "src/**/*",
      "dist-renderer/**/*",
      "assets/**/*",
      "sim/fake-atem.js"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "artifactName": "Universal-PTZ-Controller-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Universal PTZ Controller ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Universal-PTZ-Controller-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal PTZ Controller",
      "uninstallDisplayName": "Universal PTZ Controller"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Video"
    }
  }
}
